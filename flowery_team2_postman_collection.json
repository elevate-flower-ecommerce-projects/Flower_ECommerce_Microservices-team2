    {
      "name": "Catalog & Storefront",
      "item": [
        {
          "name": "Get Storefront Sections (Home)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sections",
              "host": ["{{baseUrl}}"],
              "path": ["sections"]
            },
            "description": "Fetches active home screen sections (banners, best sellers, categories carousel, occasions, curated grids)."
          }
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            },
            "description": "Returns all active categories with localized names and real icon URLs."
          }
        },
        {
          "name": "Get Products by Category ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/1/products?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "1", "products"],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            },
            "description": "Returns paged products belonging to a specific category ID."
          }
        },
        {
          "name": "Get All Occasions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/occasions",
              "host": ["{{baseUrl}}"],
              "path": ["occasions"]
            },
            "description": "Returns all active occasions (Birthday, Anniversary, Valentine's Day, etc.) with localized names."
          }
        },
        {
          "name": "Get Products by Occasion ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/occasions/1/products?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["occasions", "1", "products"],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            },
            "description": "Returns paged products associated with a specific occasion."
          }
        },
        {
          "name": "Get Product Catalog Listing (Filtered / Discounted)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/catalog?pageNumber=1&pageSize=20&categoryId=1&occasionId=1",
              "host": ["{{baseUrl}}"],
              "path": ["catalog"],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                },
                {
                  "key": "categoryId",
                  "value": "1"
                },
                {
                  "key": "occasionId",
                  "value": "1"
                }
              ]
            },
            "description": "Fetches product catalog list with dynamic discounts, prices after discount, and category/occasion filters."
          }
        },
        {
          "name": "Get All Products (Products Controller)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            },
            "description": "Paged product list from Products endpoint."
          }
        },
        {
          "name": "Seed / Re-seed Catalog Database",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog/seed",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "seed"]
            },
            "description": "Admin endpoint to populate or verify Catalog database records (Categories, Occasions, Products, Sections, Discounts)."
          }
        }
      ]
    },
