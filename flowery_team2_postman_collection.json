{
  "info": {
    "_postman_id": "flowery-team2-api-gateway-collection",
    "name": "Flowery E-Commerce API Gateway (Team 2 - Full & Updated Endpoints)",
    "description": "Comprehensive Postman Collection for Flowery Team 2 Microservices architecture via API Gateway (Port 8080). Includes all Authentication, Registration, Password Recovery (Forgot/Verify OTP/Reset), User Profile, Cart Operations (Add Item, Update Quantity), Catalog Listing with dynamic discounts, Categories, Occasions, Storefront Sections, Products, Category Static Icons, Address/Order/Payment stubs, and Health diagnostics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "API Gateway Base URL (Port 8080)"
    },
    {
      "key": "bearerToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer Token for Authenticated Endpoints"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string",
      "description": "Short-lived password reset token returned by verify-otp"
    },
    {
      "key": "cartItemId",
      "value": "1",
      "type": "string",
      "description": "Cart Item ID used for quantity update operations"
    },
    {
      "key": "acceptLanguage",
      "value": "en",
      "type": "string",
      "description": "Language header (en or ar)"
    }
  ],
  "item": [
