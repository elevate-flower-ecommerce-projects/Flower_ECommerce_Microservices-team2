{
  "info": {
    "_postman_id": "flowery-team2-api-gateway-collection",
    "name": "Flowery E-Commerce API Gateway (Team 2 - Updated Endpoints)",
    "description": "Updated Postman Collection for Team 2 Microservices including all newly pulled Catalog, Occasions, Categories, Products by Category/Occasion, and Sections endpoints (Port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "API Gateway URL (Port 8080)"
    },
    {
      "key": "bearerToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer Token for Authenticated Requests"
    },
    {
      "key": "acceptLanguage",
      "value": "en",
      "type": "string",
      "description": "Language header (en or ar)"
    }
  ],
  "item": [
    {
      "name": "Health & Diagnostics",
      "item": [
        {
          "name": "API Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Identity Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/identity/health",
              "host": ["{{baseUrl}}"],
              "path": ["identity", "health"]
            }
          }
        },
        {
          "name": "Catalog Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog/health",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "health"]
            }
          }
        },
        {
          "name": "Cart Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/health",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "health"]
            }
          }
        },
        {
          "name": "Order Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/order/health",
              "host": ["{{baseUrl}}"],
              "path": ["order", "health"]
            }
          }
        },
        {
          "name": "Payment Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payment/health",
              "host": ["{{baseUrl}}"],
              "path": ["payment", "health"]
            }
          }
        },
        {
          "name": "Address Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/address/health",
              "host": ["{{baseUrl}}"],
              "path": ["address", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('bearerToken', jsonData.data.token);",
                  "    console.log('Saved token to bearerToken variable');",
                  "} else if (jsonData && jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('bearerToken', jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Login"]
            }
          }
        },
        {
          "name": "Reactivate Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "1"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Login/reactivate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Login", "reactivate"]
            }
          }
        },
        {
          "name": "Customer Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"user@example.com\",\n  \"phoneNumber\": \"+201000000000\",\n  \"gender\": 1,\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/CustomerRegistration/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "CustomerRegistration", "register"]
            }
          }
        },
        {
          "name": "Driver Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Driver Name\",\n  \"email\": \"driver@example.com\",\n  \"phoneNumber\": \"+201011111111\",\n  \"password\": \"DriverPassword123!\",\n  \"confirmPassword\": \"DriverPassword123!\",\n  \"vehicleType\": \"Motorcycle\",\n  \"vehicleNumber\": \"ABC-123\",\n  \"nationalIdNumber\": \"29901011234567\",\n  \"vehicleLicenceImage\": \"https://example.com/license.jpg\",\n  \"nationalIdImage\": \"https://example.com/national_id.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/DriverRegistration/driverregister",
              "host": ["{{baseUrl}}"],
              "path": ["api", "DriverRegistration", "driverregister"]
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Password/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Password", "forgot-password"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Password/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Password", "reset-password"]
            }
          }
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "Update Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Updated\",\n  \"email\": \"user@example.com\",\n  \"phoneNumber\": \"+201000000000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmNewPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "change-password"]
            }
          }
        },
        {
          "name": "Update Password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmNewPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/password",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "password"]
            }
          }
        }
      ]
    },
    {
      "name": "Catalog & Sections (Newly Pulled Endpoints)",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog/categories",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "categories"]
            }
          }
        },
        {
          "name": "Get Products by Category ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog/categories/:categoryId/products",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "categories", ":categoryId", "products"],
              "variable": [
                {
                  "key": "categoryId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get All Occasions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog/occasions?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "occasions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Products by Occasion ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog/occasions/:occasionId/products",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "occasions", ":occasionId", "products"],
              "variable": [
                {
                  "key": "occasionId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get All Sections (Home)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog/sections",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "sections"]
            }
          }
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/catalog/products?categoryId=1",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "products"],
              "query": [
                {
                  "key": "categoryId",
                  "value": "1",
                  "disabled": true
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
