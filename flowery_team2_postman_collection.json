    {
      "name": "Authentication & Registration",
      "item": [
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('bearerToken', jsonData.data.accessToken);",
                  "    console.log('JWT Token saved:', jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@flower.local\",\n  \"password\": \"Customer@123!\",\n  \"fcmToken\": \"dK3x9...optional_fcm_token\",\n  \"deviceId\": \"device-uuid-1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Login"]
            },
            "description": "Authenticates a customer or driver, returning user info and JWT access/refresh tokens. Automatically sets {{bearerToken}} variable."
          }
        },
        {
          "name": "Reactivate Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@flower.local\",\n  \"refreshToken\": \"V/xicLUFO4fYX2FOOC1UWivB3E0HXCP1a6YOf+quTfE=\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Login/reactivate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Login", "reactivate"]
            },
            "description": "Refreshes and reactivates access token using a valid refresh token."
          }
        },
        {
          "name": "Customer Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Mariam Ahmed\",\n  \"email\": \"mariam@example.com\",\n  \"phoneNumber\": \"01001112222\",\n  \"gender\": 1,\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/CustomerRegistration/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "CustomerRegistration", "register"]
            },
            "description": "Registers a new customer user."
          }
        },
        {
          "name": "Driver Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Hassan Driver\",\n  \"email\": \"hassan.driver@flower.local\",\n  \"phoneNumber\": \"01099887766\",\n  \"gender\": 1,\n  \"nationalId\": \"29501019988776\",\n  \"vehicleType\": \"Motorcycle\",\n  \"vehiclePlate\": \"DEF-5678\",\n  \"password\": \"Driver@123!\",\n  \"confirmPassword\": \"Driver@123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/DriverRegistration/driverregister",
              "host": ["{{baseUrl}}"],
              "path": ["api", "DriverRegistration", "driverregister"]
            },
            "description": "Registers a new driver application with vehicle and national ID details."
          }
        }
      ]
    },
    {
      "name": "Password Management",
      "item": [
        {
          "name": "Forgot Password (Send OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@flower.local\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Password/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Password", "forgot-password"]
            },
            "description": "Triggers a 6-digit OTP code to the registered email for password recovery."
          }
        },
        {
          "name": "Verify Password Reset OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.resetToken) {",
                  "    pm.collectionVariables.set('resetToken', jsonData.data.resetToken);",
                  "    console.log('Reset token saved:', jsonData.data.resetToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@flower.local\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Password/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Password", "verify-otp"]
            },
            "description": "Verifies the 6-digit OTP and generates a secure reset token. Automatically sets {{resetToken}} variable."
          }
        },
        {
          "name": "Reset Password (via ResetCode / OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@flower.local\",\n  \"resetCode\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPassword@123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Password/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Password", "reset-password"]
            },
            "description": "Resets the user password using the verified resetCode."
          }
        }
      ]
    },
    {
      "name": "User Profile & Security",
      "item": [
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Retrieves profile details of the currently authenticated user."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Layla Hassan Updated\",\n  \"phoneNumber\": \"01111111101\",\n  \"gender\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Updates profile information for the authenticated user."
          }
        },
        {
          "name": "Change Password (POST /users/me/change-password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Customer@123!\",\n  \"newPassword\": \"NewCustomer@123!\",\n  \"confirmPassword\": \"NewCustomer@123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "change-password"]
            },
            "description": "Changes the password of the authenticated user (POST route)."
          }
        },
        {
          "name": "Change Password (PUT /users/me/password)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Customer@123!\",\n  \"newPassword\": \"NewCustomer@123!\",\n  \"confirmPassword\": \"NewCustomer@123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/password",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "password"]
            },
            "description": "Changes the password of the authenticated user (PUT route)."
          }
        }
      ]
    },
    {
      "name": "Cart Operations",
      "item": [
        {
          "name": "Add Item to Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.items && jsonData.data.items.length > 0) {",
                  "    pm.collectionVariables.set('cartItemId', jsonData.data.items[0].id);",
                  "    console.log('Cart Item ID saved:', jsonData.data.items[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items"]
            },
            "description": "Adds a product item to the authenticated user's active shopping cart. Automatically saves the first cart item's ID into {{cartItemId}}."
          }
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/items/{{cartItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items", "{{cartItemId}}"]
            },
            "description": "Updates the quantity of a specific item in the cart."
          }
        }
      ]
    },
