# ─────────────────────────────────────────────────────────────────────────────
# .env  — Local environment variables loaded by docker-compose
# !! DO NOT commit this file to source control !!
# Add it to .gitignore to keep secrets out of the repository.
# ─────────────────────────────────────────────────────────────────────────────

# SQL Server SA password — must be 8+ chars with uppercase, lowercase, digit, symbol
SA_PASSWORD=Auth@Str0ngP@ss!

# IdGen machine id — change per node/container (0-1023) in multi-instance setups
IDGEN_MACHINE_ID=0

# ── JWT Settings ──────────────────────────────────────────────────────────────
# Key must be at least 32 characters (256-bit) for HMAC-SHA256 signing
JWT_KEY=Y0urSup3rStr0ngJwtS3cr3tKey!AuthSvc#2026
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthServiceClients
