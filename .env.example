# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Template for local environment variables
# Copy this file to .env and fill in the real values.
# The actual .env file is NEVER committed to source control.
# ─────────────────────────────────────────────────────────────────────────────

# SQL Server SA password — must be 8+ chars with uppercase, lowercase, digit, symbol
SA_PASSWORD=your_strong_password_here

# IdGen machine id — change per node/container (0-1023) in multi-instance setups
IDGEN_MACHINE_ID=0

# ── JWT Settings ──────────────────────────────────────────────────────────────
# Key must be at least 32 characters (256-bit) for HMAC-SHA256 signing
JWT_KEY=your_super_secret_jwt_key_min_32_chars_here
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthServiceClients
