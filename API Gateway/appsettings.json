{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route-prefix": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "identity-route-users": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "identity-route-api": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "identity-route-auth": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },

      "catalog-route-direct": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog"
        }
      },
      "catalog-route-prefix": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/catalog" }
        ]
      },
      "catalog-route-categories": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/categories/{**catch-all}"
        }
      },
      "catalog-route-occasions": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/occasions/{**catch-all}"
        }
      },
      "catalog-route-sections": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/sections/{**catch-all}"
        }
      },
      "catalog-route-products": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/products/{**catch-all}"
        }
      },

      "cart-route-prefix": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/cart/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/cart" }
        ]
      },

      "order-route-prefix": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/order/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/order" }
        ]
      },

      "payment-route-prefix": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payment/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/payment" }
        ]
      },

      "address-route-prefix": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/address/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/address" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "authservice": {
            "Address": "http://authservice:8080"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalogservice": {
            "Address": "http://catalogservice:8080"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cartservice": {
            "Address": "http://cartservice:8080"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "orderservice": {
            "Address": "http://orderservice:8080"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "paymentservice": {
            "Address": "http://paymentservice:8080"
          }
        }
      },
      "address-cluster": {
        "Destinations": {
          "addressservice": {
            "Address": "http://addressservice:8080"
          }
        }
      }
    }
  }
}
