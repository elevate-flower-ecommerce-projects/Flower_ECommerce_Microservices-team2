{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-route-health": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "catalog-route-api": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/catalog" }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },

      "cart-route-health": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/cart"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "cart-route-api": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/cart/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/cart" }
        ]
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },

      "order-route-health": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/order"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "order-route-api": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/order/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/order" }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order/{**catch-all}"
        }
      },

      "payment-route-health": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payment"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "payment-route-api": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payment/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/payment" }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },

      "address-route-health": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/address"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "address-route-api": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/address/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/address" }
        ]
      },
      "address-route": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/address/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalogservice:8080"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cartservice:8080"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://orderfulfillmentservice:8080"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://paymentservice:8080"
          }
        }
      },
      "address-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://addressstorecoverageservice:8080"
          }
        }
      }
    }
  }
}
